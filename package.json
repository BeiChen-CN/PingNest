{
  "name": "pingnest",
  "version": "0.1.0",
  "description": "PingNest",
  "main": "dist-electron/main.js",
  "engines": {
    "node": ">=22"
  },
  "author": {
    "name": "PingNest"
  },
  "scripts": {
    "postinstall": "electron-builder install-app-deps && node scripts/prepare-electron-runtime.cjs",
    "dev": "node scripts/prepare-electron-runtime.cjs && vite --mode electron",
    "test": "node --disable-warning=MODULE_TYPELESS_PACKAGE_JSON --test tests/message-baseline.test.mjs tests/notification-layout.test.mjs tests/display-name.test.mjs tests/history-grouping.test.mjs tests/sql-message-content.test.mjs",
    "typecheck": "tsc --noEmit",
    "build": "tsc && vite build && electron-builder",
    "preview": "vite preview"
  },
  "dependencies": {
    "electron-store": "^11.0.2",
    "koffi": "^2.9.0",
    "lucide-react": "^1.7.0",
    "react": "^19.2.3",
    "react-dom": "^19.2.3",
    "react-router-dom": "^7.14.0",
    "zustand": "^5.0.2"
  },
  "devDependencies": {
    "@electron/rebuild": "^4.0.2",
    "@types/react": "^19.1.0",
    "@types/react-dom": "^19.1.0",
    "@vitejs/plugin-react": "^4.3.4",
    "7zip-bin": "^5.2.0",
    "electron": "^41.1.1",
    "electron-builder": "^26.8.1",
    "sass": "^1.98.0",
    "typescript": "^6.0.2",
    "vite": "^7.0.0",
    "vite-plugin-electron": "^0.28.8",
    "vite-plugin-electron-renderer": "^0.14.6"
  },
  "build": {
    "appId": "com.pingnest.app",
    "productName": "PingNest",
    "artifactName": "PingNest-${version}-Setup.${ext}",
    "directories": {
      "output": "release"
    },
    "win": {
      "target": [
        "nsis"
      ],
      "icon": "public/icon.ico",
      "extraFiles": [
        {
          "from": "resources/runtime/win32/msvcp140.dll",
          "to": "."
        },
        {
          "from": "resources/runtime/win32/msvcp140_1.dll",
          "to": "."
        },
        {
          "from": "resources/runtime/win32/vcruntime140.dll",
          "to": "."
        },
        {
          "from": "resources/runtime/win32/vcruntime140_1.dll",
          "to": "."
        }
      ],
      "signExecutable": false,
      "signAndEditExecutable": true
    },
    "nsis": {
      "oneClick": false,
      "allowToChangeInstallationDirectory": true,
      "createDesktopShortcut": true,
      "unicode": true,
      "installerLanguages": [
        "zh_CN",
        "en_US"
      ]
    },
    "extraResources": [
      {
        "from": "resources/",
        "to": "resources/"
      },
      {
        "from": "public/icon.ico",
        "to": "icon.ico"
      },
      {
        "from": "public/icon.png",
        "to": "icon.png"
      }
    ],
    "files": [
      "dist/**/*",
      "dist-electron/**/*"
    ],
    "asarUnpack": [
      "node_modules/koffi/**/*",
      "resources/wcdb/**/*",
      "resources/key/**/*"
    ],
    "electronDist": "node_modules/electron/dist",
    "electronVersion": "41.10.6"
  }
}
